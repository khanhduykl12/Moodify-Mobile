{
  "expo": {
    "name": "Moodify",
    "slug": "moodify",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/moodify-icon.png",
    "scheme": "moodify",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a0f",
    "primaryColor": "#8b5cf6",
    "ios": {
      "icon": "./assets/images/moodify-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0f",
        "foregroundImage": "./assets/images/moodify-icon.png",
        "backgroundImage": "./assets/images/moodify-icon.png"
      },
      "backgroundColor": "#0a0a0f",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.khanhduykl12steam.moodify"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/moodify-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0a0f",
          "image": "./assets/images/moodify-logo.png",
          "imageWidth": 140
        }
      ],
      "expo-secure-store",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "82c4edc1-dcf4-4a40-98c5-3699f85b24d4"
      }
    }
  }
}
